# LLM provider: gemini (default), anthropic or openai
LLM_PROVIDER=gemini

# Gemini (free key from Google AI Studio)
GEMINI_API_KEY=
# Pick a current model name from Google AI Studio
GEMINI_MODEL=

# Optional, for later
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Request throttling for the Gemini free tier
LLM_MAX_REQUESTS_PER_MINUTE=10
LLM_MAX_RETRIES=5
# Cache LLM replies on disk (data/llm_cache.sqlite). Turn off for pass^k trials.
LLM_CACHE=true

# Tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shophelp-agent

# Paths (all on E:)
DATA_DIR=E:/projects/shophelp-agent/data
DB_PATH=E:/projects/shophelp-agent/data/shop.db

# Refunds above this amount need staff approval
REFUND_APPROVAL_THRESHOLD=200

# Evaluation: the first EVAL_TASK_COUNT tasks of EVAL_SPLIT (test, train or base),
# or an explicit comma-separated list in EVAL_TASK_IDS (overrides both)
EVAL_SPLIT=test
EVAL_TASK_COUNT=15
EVAL_TASK_IDS=
EVAL_TRIALS=3
